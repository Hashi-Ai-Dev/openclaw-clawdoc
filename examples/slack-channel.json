{
  "channels": {
    "slack": {
      "accounts": {
        "default": {
          "enabled": true,
          "botToken": "YOUR_SLACK_BOT_TOKEN",
          "signingSecret": "YOUR_SLACK_SIGNING_SECRET",
          "appToken": "YOUR_SLACK_APP_TOKEN",
          "socketMode": true,
          "dmPolicy": "pairing",
          "allowFrom": ["YOUR_SLACK_USER_ID"],
          "channels": {
            "allowFrom": ["YOUR_SLACK_CHANNEL_ID"]
          }
        }
      }
    }
  }
}
